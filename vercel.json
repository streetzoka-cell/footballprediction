{
  "functions": {
    "api/ssr.js": { "maxDuration": 10, "includeFiles": "dist/**" }
  },
  "rewrites": [
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/opensearch.xml", "destination": "/opensearch.xml" },
    { "source": "/manifest.webmanifest", "destination": "/manifest.webmanifest" },
    { "source": "/zokascore-sitemap.xml", "destination": "https://api.zokascore.xyz/zokascore-sitemap.xml" },
    { "source": "/sitemap.xml", "destination": "https://api.zokascore.xyz/zokascore-sitemap.xml" },
    { "source": "/sitemaps/:type*", "destination": "https://api.zokascore.xyz/sitemaps/:type*" },
    { "source": "/match/:path*", "destination": "/api/ssr" },
    { "source": "/team/:path*", "destination": "/api/ssr" },
    { "source": "/league/:path*", "destination": "/api/ssr" },
    { "source": "/competition/:path*", "destination": "/api/ssr" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}